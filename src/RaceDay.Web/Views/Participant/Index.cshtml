@model RaceDay.Web.Models.ParticipantHomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<section class="raceday-hero rounded-4 p-4 p-md-5 mb-4 text-white">
    <p class="text-uppercase fw-semibold mb-2">Your next start line</p>
    <h1 class="display-5 fw-bold">Find your next RaceDay</h1>
    <p class="lead mb-0">Discover upcoming runs, walks and rides, then choose the category that fits you.</p>
</section>

<section aria-labelledby="event-search-heading" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 id="event-search-heading" class="h4">Find an event</h2>
        <form asp-action="Index" method="get" class="row g-3 align-items-end" data-api-form data-pending-label="Searching events…">
            <div class="col-12 col-md-4">
                <label for="search" class="form-label">Name or location</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" maxlength="100" />
            </div>
            <div class="col-12 col-md-2">
                <label for="eventType" class="form-label">Event type</label>
                <select id="eventType" name="eventType" class="form-select">
                    <option value="">All types</option>
                    @foreach (var type in new[] { "Run", "Walk", "Cycle" })
                    {
                        <option value="@type" selected="@(Model.EventType == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="fromDate" class="form-label">From</label>
                <input id="fromDate" name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label for="toDate" class="form-label">To</label>
                <input id="toDate" name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Search events</button>
            </div>
        </form>
    </div>
</section>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Events.Count == 0)
{
    <div class="alert alert-info" role="status">No upcoming events match these filters. Try a wider date range or clear the search.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h2 class="h3 mb-0">Upcoming events</h2>
        <span class="text-muted">@Model.Events.Count event(s)</span>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model.Events)
        {
            <div class="col">
                <article class="card h-100 border-0 shadow-sm event-card">
                    @if (!string.IsNullOrWhiteSpace(item.EventBannerUrl))
                    {
                        <img src="@item.EventBannerUrl" class="card-img-top event-banner" alt="Banner for @item.Name" />
                    }
                    else
                    {
                        <div class="event-banner-fallback d-flex align-items-end p-3" role="img" aria-label="RaceDay event banner placeholder">
                            <span class="badge text-bg-light">@item.EventType</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <p class="text-uppercase small fw-semibold text-primary mb-1">@item.EventType · @item.Distance.ToString("0.##") km</p>
                        <h3 class="h4 card-title">@item.Name</h3>
                        <p class="text-muted mb-1"><time datetime="@item.EventDate.ToString("O")">@item.EventDate.ToString("dd MMM yyyy · HH:mm")</time></p>
                        <p class="text-muted">@item.Location</p>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="card-text">@(item.Description.Length > 150 ? item.Description[..150] + "…" : item.Description)</p>
                        }
                        <a asp-action="Details" asp-route-eventId="@item.EventID" class="btn btn-outline-primary mt-auto">View event</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
