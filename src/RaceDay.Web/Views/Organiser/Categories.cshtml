@model RaceDay.Web.Models.OrganiserCategoriesViewModel
@{
    ViewData["Title"] = "Event categories";
    var editing = Model.Edit.CategoryID.HasValue;
}
<p><a asp-action="Index">&larr; Back to dashboard</a></p>
<h1>Categories <span class="text-muted">/ @Model.EventName</span></h1>
@if (Model.SuccessMessage is not null) { <div class="alert alert-success" role="status">@Model.SuccessMessage</div> }
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
<div class="row g-4">
    <section class="col-12 col-lg-7" aria-labelledby="category-list-heading">
        <h2 id="category-list-heading" class="h4">Available categories</h2>
        @if (Model.Categories.Count == 0)
        {
            <div class="alert alert-info" role="status">No categories have been added to this event yet.</div>
        }
        else
        {
            <div class="table-responsive card border-0 shadow-sm"><table class="table align-middle mb-0">
                <caption class="visually-hidden">Categories for @Model.EventName</caption>
                <thead class="table-light"><tr><th scope="col">Category</th><th scope="col">Age range</th><th scope="col">Distance</th><th scope="col">Actions</th></tr></thead>
                <tbody>@foreach (var item in Model.Categories)
                {
                    <tr>
                        <td>@item.CategoryName</td>
                        <td>@(item.MinAge.HasValue || item.MaxAge.HasValue ? $"{item.MinAge?.ToString() ?? "Any"}–{item.MaxAge?.ToString() ?? "Any"}" : "All ages")</td>
                        <td>@(item.Distance?.ToString("0.##") is string distance ? $"{distance} km" : "Not set")</td>
                        <td><div class="d-flex gap-2">
                            <a asp-action="EditCategory" asp-route-eventId="@Model.EventID" asp-route-categoryId="@item.CategoryID" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="DeleteCategory" asp-route-eventId="@Model.EventID" asp-route-categoryId="@item.CategoryID" method="post" onsubmit="return confirm('Delete this category? The API will refuse if entries use it.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div></td>
                    </tr>
                }</tbody>
            </table></div>
        }
    </section>
    <section class="col-12 col-lg-5" aria-labelledby="category-form-heading">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h2 id="category-form-heading" class="h4">@(editing ? "Edit category" : "Add a category")</h2>
            <form asp-action="@(editing ? "EditCategory" : "CreateCategory")" asp-route-eventId="@Model.EventID" asp-route-categoryId="@Model.Edit.CategoryID" method="post" data-api-form data-pending-label="Saving category…">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3"><label asp-for="Edit.CategoryName" class="form-label"></label><input asp-for="Edit.CategoryName" class="form-control" maxlength="100" /><span asp-validation-for="Edit.CategoryName" class="text-danger"></span></div>
                <div class="row g-3">
                    <div class="col-6"><label asp-for="Edit.MinAge" class="form-label"></label><input asp-for="Edit.MinAge" class="form-control" min="0" max="150" /><span asp-validation-for="Edit.MinAge" class="text-danger"></span></div>
                    <div class="col-6"><label asp-for="Edit.MaxAge" class="form-label"></label><input asp-for="Edit.MaxAge" class="form-control" min="0" max="150" /><span asp-validation-for="Edit.MaxAge" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="Edit.Distance" class="form-label"></label><div class="input-group"><input asp-for="Edit.Distance" class="form-control" type="number" min="0.01" max="999.99" step="0.01" /><span class="input-group-text">km</span></div><span asp-validation-for="Edit.Distance" class="text-danger"></span></div>
                </div>
                <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">@(editing ? "Save category" : "Add category")</button>@if (editing) { <a asp-action="Categories" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary">Cancel edit</a> }</div>
            </form>
        </div></div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
